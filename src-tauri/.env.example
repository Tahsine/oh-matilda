# Clé Ollama Cloud — NE PAS COMMITER le vrai fichier `.env`.
# La clé est lue côté Rust (`get_ollama_key`), jamais hardcodée en JS.
# IMPORTANT Android : le binaire est compilé sur PC, donc exporter la clé
# dans le shell AVANT dev/build pour qu'elle soit visible (runtime desktop
# ou `option_env!` compile-time sur device) :
#   export OLLAMA_API_KEY=...
#   npm run tauri android dev
# Créer la clé sur : https://ollama.com/settings/keys
OLLAMA_API_KEY=ollama_xxx
